# Local credentials only. Copy this file to .env and never commit .env.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=sanba_ahou
DATABASE_USER=sanba_app
DATABASE_PASSWORD=

ARTICLE_EDIT_ENABLED=false

# Same Google Maps Platform key must allow Geolocation API and Geocoding API.
GOOGLE_GEOLOCATION_API_KEY=

# WeatherAPI.com key. Keep it on the backend only.
WEATHERAPI_API_KEY=

MQTT_HOST=
MQTT_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS_ENABLED=true
MQTT_CA_CERT_PATH=
MQTT_CLIENT_ID=sanba-backend

# Email/password web sign-in.
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTH_SESSION_COOKIE_NAME=sanba_session
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_DAYS=30
