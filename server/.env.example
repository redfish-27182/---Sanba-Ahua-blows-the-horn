# 複製為 .env 後再填入真實設定。此範本可提交到 Git，但不要填入密碼。

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=sanba_ahou
DATABASE_USER=sanba_app
DATABASE_PASSWORD=

# 僅限本機測試使用；沒有管理員驗證，正式環境不可開啟。
ARTICLE_EDIT_ENABLED=false

# Google Geolocation API 金鑰只放在本機 .env；請勿提交真實金鑰。
GOOGLE_GEOLOCATION_API_KEY=
# 此金鑰需同時允許 Geolocation API 與 Geocoding API。

MQTT_HOST=
MQTT_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS_ENABLED=true
# EMQX Cloud 使用公開 CA 時可留空；若日後改用私有 CA，填入 PEM 檔案路徑。
MQTT_CA_CERT_PATH=
MQTT_CLIENT_ID=sanba-backend
